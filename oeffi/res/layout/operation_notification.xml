<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/operation_notification_status"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/operation_notification_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginTop="3dp"
                android:layout_marginLeft="3dp"
                android:textColor="@color/fg_trip_next_event_normal"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textSize="@dimen/operation_notification_line_fontsize"/>
            <TextView
                android:id="@+id/operation_notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="@color/fg_trip_next_event_normal"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:textSize="@dimen/operation_notification_time_fontsize"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/operation_notification_station_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg_trip_next_event_normal"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:textSize="@dimen/operation_notification_station_fontsize"/>
        <TextView
            android:id="@+id/operation_notification_station_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fg_trip_next_event_normal"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:textSize="@dimen/operation_notification_station_fontsize"/>
    </LinearLayout>
</RelativeLayout>

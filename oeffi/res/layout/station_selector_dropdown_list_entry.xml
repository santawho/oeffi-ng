<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_divider"
    android:paddingVertical="@dimen/text_padding_vertical_cram">

    <de.schildbach.oeffi.util.LineView
        android:id="@+id/station_selector_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/bg_shaded"
        android:paddingLeft="@dimen/text_padding_horizontal_lax"
        android:paddingVertical="@dimen/text_padding_vertical_verylax"
        android:textSize="@dimen/font_size_small" />

    <TextView
        android:id="@+id/station_selector_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/bg_shaded"
        android:paddingHorizontal="@dimen/text_padding_horizontal_lax"
        android:paddingVertical="@dimen/text_padding_vertical_verylax"
        android:ellipsize="middle"/>
</LinearLayout>

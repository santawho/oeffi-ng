<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/text_padding_vertical_cram" >

    <TextView
        android:id="@+id/vehicle_information_section_label"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/text_padding_vertical"
        android:paddingHorizontal="@dimen/text_padding_horizontal"
        android:textSize="@dimen/font_size_large"
        android:textStyle="bold"
        android:textColor="@color/vehicle_information_section_label_foreground"
        android:background="@color/vehicle_information_section_label_background" />

</LinearLayout>
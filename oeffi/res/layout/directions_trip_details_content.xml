<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigation_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="@dimen/elevation_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/directions_trip_details_content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:elevation="@dimen/elevation_content">

            <include layout="@layout/action_bar" />

            <de.schildbach.oeffi.util.HorizontalPager
                android:id="@+id/directions_trip_details_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/directions_trip_details_list_frame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <include layout="@layout/directions_trip_details_list_content" />

                    <include layout="@layout/map_frame" android:id="@+id/vertical_map_frame" />
                </LinearLayout>

<!--                <include layout="@layout/navigation_next_event" />-->
<!--                <include layout="@layout/navigation_event_log" android:visibility="gone" />-->

            </de.schildbach.oeffi.util.HorizontalPager>
        </LinearLayout>

        <include layout="@layout/map_frame" android:id="@+id/map_frame" />
    </LinearLayout>

    <include layout="@layout/navigation_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>

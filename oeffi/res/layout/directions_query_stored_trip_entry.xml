<?xml version="1.0" encoding="utf-8"?>
<com.daimajia.swipe.SwipeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:drag_edge="left|right"
    app:show_mode="lay_down">
    <ImageView
        android:id="@+id/directions_query_stored_trip_entry_swipe_navigate"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:paddingVertical="@dimen/text_padding_vertical_verylax"
        android:paddingHorizontal="@dimen/text_padding_horizontal_verylax"
        android:src="@drawable/ic_navigation_white_24dp"
        android:tint="@color/fg_significant"/>
    <ImageView
        android:id="@+id/directions_query_stored_trip_entry_swipe_remove"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:paddingVertical="@dimen/text_padding_vertical_verylax"
        android:paddingHorizontal="@dimen/text_padding_horizontal_verylax"
        android:src="@drawable/ic_clear_black_24dp"
        android:tint="@color/fg_significant"/>
    <FrameLayout
        android:id="@+id/directions_query_stored_trip_entry_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/stored_trip_entry_background_finished"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/directions_query_stored_trip_entry_icon"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingVertical="@dimen/text_padding_vertical"
                android:paddingHorizontal="@dimen/text_padding_horizontal_lax"
                android:src="@drawable/ic_bookmarked_white_24dp"
                android:tint="@color/fg_less_significant" />

            <TextView
                android:id="@+id/directions_query_stored_trip_entry_time_left"
                android:layout_weight="4"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_horizontal"
                android:textSize="@dimen/font_size_large" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_weight="7"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:paddingVertical="@dimen/text_padding_vertical"
                android:paddingHorizontal="@dimen/text_padding_horizontal_lax" >

                <TextView
                    android:id="@+id/directions_query_stored_trip_entry_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/directions_query_stored_trip_entry_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_weight="28"
                android:layout_width="0px"
                android:layout_height="wrap_content" >

                <de.schildbach.oeffi.util.locationview.LocationTextView
                    android:id="@+id/directions_query_stored_trip_entry_from"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/text_padding_horizontal_lax"
                    android:drawableTint="@color/fg_less_significant"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/text_padding_horizontal_verylax"
                    android:paddingRight="@dimen/text_padding_horizontal_cram"
                    android:paddingTop="@dimen/text_padding_vertical_verylax" />

                <de.schildbach.oeffi.util.locationview.LocationTextView
                    android:id="@+id/directions_query_stored_trip_entry_to"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/text_padding_horizontal_lax"
                    android:drawableTint="@color/fg_less_significant"
                    android:gravity="center_vertical"
                    android:paddingBottom="@dimen/text_padding_vertical_verylax"
                    android:paddingLeft="@dimen/text_padding_horizontal_verylax"
                    android:paddingRight="@dimen/text_padding_horizontal_cram" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</com.daimajia.swipe.SwipeLayout>

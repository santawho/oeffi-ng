<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/user_interface_preferences_title" >

    <ListPreference
        android:enabled="true"
        android:key="user_interface_darkmode_switch"
        android:defaultValue="system"
        android:entries="@array/user_interface_darkmode_switch_titles"
        android:entryValues="@array/user_interface_darkmode_switch_values"
        android:title="@string/user_interface_darkmode_switch_title"
        android:summary="@string/user_interface_darkmode_switch_summary" />

    <CheckBoxPreference
        android:key="user_interface_darkmode_amoled_enabled"
        android:defaultValue="false"
        android:title="@string/user_interface_darkmode_amoled_enabled_title"
        android:summary="@string/user_interface_darkmode_amoled_enabled_summary" />

    <CheckBoxPreference
        android:key="user_interface_trip_details_on_lockscreen_enabled"
        android:defaultValue="false"
        android:summary="@string/user_interface_trip_details_on_lockscreen_summary"
        android:title="@string/user_interface_trip_details_on_lockscreen_title" />

    <CheckBoxPreference
        android:key="user_interface_show_data_source_enabled"
        android:defaultValue="true"
        android:title="@string/user_interface_show_data_source_enabled_title" />

    <CheckBoxPreference
        android:key="user_interface_location_action_buttons_enabled"
        android:defaultValue="true"
        android:title="@string/user_interface_location_action_buttons_enabled_title"
        android:summary="@string/user_interface_location_action_buttons_enabled_summary" />

    <PreferenceCategory
        android:title="@string/user_interface_font_category_title" >

        <CheckBoxPreference
            android:key="user_interface_font_enabled"
            android:defaultValue="true"
            android:title="@string/user_interface_font_enabled_title"
            android:summary="@string/user_interface_font_enabled_summary" />

        <de.schildbach.oeffi.preference.CustomPreference
            android:key="user_interface_font_install"
            android:title="@string/user_interface_font_install_title"
            android:summary="@string/user_interface_font_install_summary" />

        <de.schildbach.oeffi.preference.CustomPreference
            android:key="user_interface_font_delete"
            android:title="@string/user_interface_font_delete_title"
            android:summary="@string/user_interface_font_delete_summary" />

    </PreferenceCategory>


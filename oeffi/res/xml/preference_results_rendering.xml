<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/user_interface_category_results_title" >

    <CheckBoxPreference
        android:key="user_interface_results_noprovidercolors_enabled"
        android:defaultValue="false"
        android:title="@string/user_interface_results_noprovidercolors_enabled_title"
        android:summary="@string/user_interface_results_noprovidercolors_enabled_summary" />

    <CheckBoxPreference
        android:key="user_interface_results_preferpredefinedcolors_enabled"
        android:defaultValue="false"
        android:title="@string/user_interface_results_preferpredefinedcolors_enabled_title"
        android:summary="@string/user_interface_results_preferpredefinedcolors_enabled_summary" />

    <CheckBoxPreference
        android:key="user_interface_results_highlight_cancelled_enabled"
        android:defaultValue="true"
        android:title="@string/user_interface_results_highlight_cancelled_enabled_title"
        android:summary="@string/user_interface_results_highlight_cancelled_enabled_summary" />

    <CheckBoxPreference
        android:key="user_interface_results_directions_special_rendering_enabled"
        android:defaultValue="false"
        android:title="@string/user_interface_results_directions_special_rendering_enabled_title"
        android:summary="@string/user_interface_results_directions_special_rendering_enabled_summary" />

    <CheckBoxPreference
        android:key="user_interface_results_remark_without_links_enabled"
        android:disableDependentsState="true"
        android:defaultValue="false"
        android:title="@string/user_interface_results_remark_without_links_enabled_title"
        android:summary="@string/user_interface_results_remark_without_links_enabled_summary" />

    <CheckBoxPreference
        android:dependency="user_interface_results_remark_without_links_enabled"
        android:key="user_interface_results_remark_links_clickable_enabled"
        android:defaultValue="true"
        android:title="@string/user_interface_results_remark_links_clickable_enabled_title"
        android:summary="@string/user_interface_results_remark_links_clickable_enabled_summary" />

</PreferenceScreen>
